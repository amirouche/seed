;;; benchmark-gremlin.seed2 — Graph Traversal with Environment-Threading
;;;
;;; Exercises the (values news out) calling convention by implementing
;;; Gremlin-style as! steps that bind traversal state into the caller's
;;; scope via (define env ...).
;;;
;;; Computes: triangle count in a random graph where all three vertices
;;; share the same group label.

;; ============================================================
;; DSL: Gremlin-style as! step
;; ============================================================
;; Each (as! name expr) triggers (values news out) at compile time,
;; binding the result as a proper Chez variable in the caller's scope.

(define as! (vau (name val-expr) env
  (define env name (eval val-expr env))))

(define and2 (vau (a b) e (if (eval a e) (eval b e) #f)))

;; ============================================================
;; Deterministic PRNG (linear congruential, purely functional)
;; ============================================================

(define rng-next
  (lambda (s)
    (let ((next (remainder (+ (* s 1103515245) 12345) 2147483648)))
      (if (< next 0) (- 0 next) next))))

;; ============================================================
;; Graph representation
;; ============================================================
;; Graph is a list of entries ordered by vertex id: ((group . neighbors) ...)
;; Vertex i is at position i in the list.
;; - group: integer label 0..G-1
;; - neighbors: list of vertex indices
;;
;; For O(1)-ish access we also build a neighbor-set representation:
;; each vertex stores a sorted neighbor list for fast edge? checks.

(define make-graph
  (lambda (n edges-per-vertex num-groups rng-seed)
    ;; Build vertex entries with groups (no edges yet)
    (let build ((i 0) (s rng-seed) (acc '()))
      (if (= i n)
          (let ((entries (reverse acc)))
            ;; Add random edges
            (let add-edges ((rest entries) (idx 0) (s2 s) (result '()))
              (if (null? rest)
                  (reverse result)
                  (let ((entry (car rest)))
                    (let add-e ((j 0) (s3 s2) (nbrs '()))
                      (if (= j edges-per-vertex)
                          (add-edges (cdr rest) (+ idx 1) s3
                                     (cons (cons (car entry) nbrs) result))
                          (let ((s4 (rng-next s3)))
                            (let ((target (remainder s4 n)))
                              (if (= target idx)
                                  (add-e j s4 nbrs)
                                  (add-e (+ j 1) s4 (cons target nbrs)))))))))))
          (let ((s2 (rng-next s)))
            (build (+ i 1) s2
                   (cons (list (remainder s2 num-groups)) acc)))))))

;; list-ref is O(n) but we call it once per vertex per loop level,
;; not inside the innermost loop. The hot path uses pre-fetched data.

(define graph-ref
  (lambda (g v)
    (list-ref g v)))

(define graph-group
  (lambda (entry)
    (car entry)))

(define graph-neighbors
  (lambda (entry)
    (cdr entry)))

(define edge?
  (lambda (g from to)
    (memv to (graph-neighbors (graph-ref g from)))))

;; ============================================================
;; Triangle counting — Gremlin-style with as! bindings
;; ============================================================
;; For each vertex a, follow edges to b, then to c, check c→a.
;; Filter: all three must share the same group label.
;;
;; The as! calls bind the looked-up entry/group data so that
;; inner loops reference proper Chez variables, not repeated lookups.

(define count-triangles
  (lambda (g n)
    (let loop-a ((ai 0) (count 0))
      (if (= ai n) count
          (begin
            (as! a-entry (graph-ref g ai))
            (as! a-grp (graph-group a-entry))
            (as! a-nbrs (graph-neighbors a-entry))
            (let loop-b ((bs a-nbrs) (count count))
              (if (null? bs)
                  (loop-a (+ ai 1) count)
                  (begin
                    (as! bi (car bs))
                    (as! b-entry (graph-ref g bi))
                    (as! b-grp (graph-group b-entry))
                    (if (not (= a-grp b-grp))
                        (loop-b (cdr bs) count)
                        (begin
                          (as! b-nbrs (graph-neighbors b-entry))
                          (let loop-c ((cs b-nbrs) (count count))
                            (if (null? cs)
                                (loop-b (cdr bs) count)
                                (begin
                                  (as! ci (car cs))
                                  (if (and2 (= a-grp (graph-group (graph-ref g ci)))
                                            (edge? g ci ai))
                                      (loop-c (cdr cs) (+ count 1))
                                      (loop-c (cdr cs) count)))))))))))))))

;; ============================================================
;; Correctness check (small graph)
;; ============================================================

(display "Gremlin Graph Traversal Benchmark (exercises (values news out) convention)")
(newline)
(newline)

(let ((g (make-graph 20 5 3 42)))
  (let ((tri (count-triangles g 20)))
    (display "Small graph (20 vertices, 5 edges/v, 3 groups): ")
    (display tri)
    (display " triangles")
    (newline)))

;; ============================================================
;; Benchmark
;; ============================================================

(define gremlin-n
  (let ((env-val (getenv "SEED_GREMLIN_N")))
    (if env-val (string->number env-val) 20000)))

(define gremlin-e
  (let ((env-val (getenv "SEED_GREMLIN_E")))
    (if env-val (string->number env-val) 20)))

(let ((g (make-graph gremlin-n gremlin-e 10 12345)))
  (display "Graph: ")
  (display gremlin-n)
  (display " vertices, ")
  (display gremlin-e)
  (display " edges/vertex, 10 groups")
  (newline)
  (let ((tri (time (count-triangles g gremlin-n))))
    (display tri)
    (display " triangles")
    (newline)))
