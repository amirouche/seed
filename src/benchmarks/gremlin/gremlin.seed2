;;; benchmark-gremlin.seed2 — Graph Traversal with gremlin-fold
;;;
;;; gremlin-fold is a 5-line vau operative that loops over a stream,
;;; binds each element into the caller's scope via (define env ...),
;;; and evaluates a body expression for each element. The compiler
;;; fully specializes it: zero seed-eval, zero env-ref at call sites.
;;;
;;; The equivalent Chez version uses a syntax-rules macro.
;;; Both produce the same nested fold-left code. The difference:
;;; the vau is written like a function, the macro requires understanding
;;; syntax-rules, hygiene, and compile-time pattern matching.
;;;
;;; Computes: triangle count in a random graph where all three vertices
;;; share the same group label.

;; ============================================================
;; gremlin-fold — the entire DSL in 5 lines
;; ============================================================
;;
;; (gremlin-fold name stream acc body)
;;   Iterates stream. Binds each element to name via define env.
;;   Evaluates body for each element. body returns new acc.
;;   Returns final acc.

(define gremlin-fold
  (vau (name stream-expr acc-expr body) env
    (letrec
        ((loop (lambda (items acc)
                 (if (null? items) acc
                     (begin
                       (define env name (car items))
                       (loop (cdr items) (eval body env)))))))
      (loop (eval stream-expr env) (eval acc-expr env)))))

;; ============================================================
;; Deterministic PRNG
;; ============================================================

(define rng-next
  (lambda (s)
    (let ((next (remainder (+ (* s 1103515245) 12345) 2147483648)))
      (if (< next 0) (- 0 next) next))))

;; ============================================================
;; Graph representation
;; ============================================================

(define make-graph
  (lambda (n edges-per-vertex num-groups rng-seed)
    (let build ((i 0) (s rng-seed) (acc '()))
      (if (= i n)
          (let ((entries (reverse acc)))
            (let add-edges ((rest entries) (idx 0) (s2 s) (result '()))
              (if (null? rest)
                  (reverse result)
                  (let ((entry (car rest)))
                    (let add-e ((j 0) (s3 s2) (nbrs '()))
                      (if (= j edges-per-vertex)
                          (add-edges (cdr rest) (+ idx 1) s3
                                     (cons (cons (car entry) nbrs) result))
                          (let ((s4 (rng-next s3)))
                            (let ((target (remainder s4 n)))
                              (if (= target idx)
                                  (add-e j s4 nbrs)
                                  (add-e (+ j 1) s4 (cons target nbrs)))))))))))
          (let ((s2 (rng-next s)))
            (build (+ i 1) s2
                   (cons (list (remainder s2 num-groups)) acc)))))))

(define graph-ref
  (lambda (g v) (list-ref g v)))

(define graph-group
  (lambda (entry) (car entry)))

(define graph-neighbors
  (lambda (entry) (cdr entry)))

(define out
  (lambda (g v) (graph-neighbors (graph-ref g v))))

(define same-group?
  (lambda (g a b)
    (= (graph-group (graph-ref g a))
       (graph-group (graph-ref g b)))))

(define edge?
  (lambda (g from to)
    (if (memv to (graph-neighbors (graph-ref g from))) #t #f)))

;; ============================================================
;; Triangle counting — nested gremlin-fold
;; ============================================================
;;
;; Three nested folds: vertices → neighbors → neighbors-of-neighbors.
;; Each gremlin-fold binds the current element (a, b, c) into scope
;; via define env. Filters use plain if on the bound variables.

(define count-triangles
  (lambda (g)
    (gremlin-fold a (iota (length g)) 0
      (gremlin-fold b (out g a) acc
        (if (not (same-group? g a b)) acc
            (gremlin-fold c (out g b) acc
              (if (not (same-group? g a c)) acc
                  (if (edge? g c a)
                      (+ acc 1)
                      acc))))))))

;; ============================================================
;; Correctness check
;; ============================================================

(display "Gremlin Graph Traversal Benchmark (gremlin-fold with vau)")
(newline)
(newline)

(let ((g (make-graph 20 5 3 42)))
  (let ((tri (count-triangles g)))
    (display "Small graph (20 vertices, 5 edges/v, 3 groups): ")
    (display tri)
    (display " triangles")
    (newline)))

;; ============================================================
;; Benchmark
;; ============================================================

(define gremlin-n
  (let ((env-val (getenv "SEED_GREMLIN_N")))
    (if env-val (string->number env-val) 20000)))

(define gremlin-e
  (let ((env-val (getenv "SEED_GREMLIN_E")))
    (if env-val (string->number env-val) 20)))

(let ((g (make-graph gremlin-n gremlin-e 10 12345)))
  (display "Graph: ")
  (display gremlin-n)
  (display " vertices, ")
  (display gremlin-e)
  (display " edges/vertex, 10 groups")
  (newline)
  (let ((tri (time (count-triangles g))))
    (display tri)
    (display " triangles")
    (newline)))
