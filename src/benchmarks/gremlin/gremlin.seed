;;; benchmark-gremlin.seed — Graph Traversal (Seed1 baseline)
;;;
;;; Same triangle-counting algorithm as gremlin.seed2 but using plain
;;; let/letrec bindings instead of as! operatives. Provides the Seed1
;;; baseline for comparison against Seed2's (values news out) convention.

(define and2 (vau (a b) e (if (eval a e) (eval b e) #f)))

;; ============================================================
;; Deterministic PRNG (linear congruential, purely functional)
;; ============================================================

(define rng-next
  (lambda (s)
    (let ((next (remainder (+ (* s 1103515245) 12345) 2147483648)))
      (if (< next 0) (- 0 next) next))))

;; ============================================================
;; Graph representation
;; ============================================================
;; Graph is a list of entries ordered by vertex id: ((group . neighbors) ...)
;; Vertex i is at position i in the list.

(define make-graph
  (lambda (n edges-per-vertex num-groups rng-seed)
    (letrec
        ((build
          (lambda (i s acc)
            (if (= i n)
                (let ((entries (reverse acc)))
                  (add-edges entries 0 s '()))
                (let ((s2 (rng-next s)))
                  (build (+ i 1) s2
                         (cons (list (remainder s2 num-groups)) acc))))))
         (add-edges
          (lambda (rest idx s2 result)
            (if (null? rest)
                (reverse result)
                (let ((entry (car rest)))
                  (add-e 0 s2 '() rest idx result entry)))))
         (add-e
          (lambda (j s3 nbrs rest idx result entry)
            (if (= j edges-per-vertex)
                (add-edges (cdr rest) (+ idx 1) s3
                           (cons (cons (car entry) nbrs) result))
                (let ((s4 (rng-next s3)))
                  (let ((target (remainder s4 n)))
                    (if (= target idx)
                        (add-e j s4 nbrs rest idx result entry)
                        (add-e (+ j 1) s4 (cons target nbrs) rest idx result entry))))))))
      (build 0 rng-seed '()))))

(define graph-ref
  (lambda (g v)
    (list-ref g v)))

(define graph-group
  (lambda (entry)
    (car entry)))

(define graph-neighbors
  (lambda (entry)
    (cdr entry)))

(define edge?
  (lambda (g from to)
    (memv to (graph-neighbors (graph-ref g from)))))

;; ============================================================
;; Triangle counting — plain letrec loops
;; ============================================================

(define count-triangles
  (lambda (g n)
    (letrec
        ((loop-a
          (lambda (ai count)
            (if (= ai n) count
                (let ((a-entry (graph-ref g ai)))
                  (let ((a-grp (graph-group a-entry))
                        (a-nbrs (graph-neighbors a-entry)))
                    (loop-b ai a-grp a-nbrs (loop-a (+ ai 1) count)))))))
         (loop-b
          (lambda (ai a-grp bs count)
            (if (null? bs) count
                (let ((bi (car bs)))
                  (let ((b-entry (graph-ref g bi)))
                    (let ((b-grp (graph-group b-entry)))
                      (if (not (= a-grp b-grp))
                          (loop-b ai a-grp (cdr bs) count)
                          (let ((b-nbrs (graph-neighbors b-entry)))
                            (loop-b ai a-grp (cdr bs)
                                    (loop-c ai a-grp b-nbrs count))))))))))
         (loop-c
          (lambda (ai a-grp cs count)
            (if (null? cs) count
                (let ((ci (car cs)))
                  (if (and2 (= a-grp (graph-group (graph-ref g ci)))
                            (edge? g ci ai))
                      (loop-c ai a-grp (cdr cs) (+ count 1))
                      (loop-c ai a-grp (cdr cs) count)))))))
      (loop-a 0 0))))

;; ============================================================
;; Correctness check (small graph)
;; ============================================================

(display "Gremlin Graph Traversal Benchmark (Seed1 baseline)")
(newline)
(newline)

(let ((g (make-graph 20 5 3 42)))
  (let ((tri (count-triangles g 20)))
    (display "Small graph (20 vertices, 5 edges/v, 3 groups): ")
    (display tri)
    (display " triangles")
    (newline)))

;; ============================================================
;; Benchmark
;; ============================================================

(define gremlin-n
  (let ((env-val (getenv "SEED_GREMLIN_N")))
    (if env-val (string->number env-val) 20000)))

(define gremlin-e
  (let ((env-val (getenv "SEED_GREMLIN_E")))
    (if env-val (string->number env-val) 20)))

(let ((g (make-graph gremlin-n gremlin-e 10 12345)))
  (display "Graph: ")
  (display gremlin-n)
  (display " vertices, ")
  (display gremlin-e)
  (display " edges/vertex, 10 groups")
  (newline)
  (let ((tri (time (count-triangles g gremlin-n))))
    (display tri)
    (display " triangles")
    (newline)))
